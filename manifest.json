{
  "schemaVersion": 1,
  "id": "io.github.moyunliuyin.cline-upstream",
  "name": "Cline Upstream",
  "version": "0.4.1",
  "description": "把 ClinePass 的真实上游摊开看：每个请求落在哪个上游、还有多少备选、缓存命中与成本。可勾选目标上游探测路由字段，实测网关会忽略。",
  "author": "moyunliuyin",
  "license": "MIT",
  "main": "main.js",
  "categories": [
    "productivity"
  ],
  "permissions": [
    "ui.panel",
    "background.service",
    "provider.register"
  ],
  "engines": {
    "piDesktop": ">=0.15.0"
  },
  "safetyNotes": "Runs a loopback OpenAI-compatible endpoint on 127.0.0.1:41891 and forwards chat requests to api.cline.bot. The ClinePass API key you enter for this provider is passed through in memory only and is never written to disk by this plugin. Responses are read in memory to extract the gateway's own routing metadata (finalProvider / pinnedProvider / fallbacksAvailable) and the last result per model is stored in the plugin data directory. Nothing is sent anywhere except api.cline.bot and the local panel.",
  "i18n": {
    "en": {
      "name": "Cline Upstream",
      "description": "See ClinePass real upstreams: which provider served each request, how many fallbacks remain, cache hits and cost. Target upstreams can be probed, but the gateway ignores the routing field.",
      "safetyNotes": "Runs a loopback OpenAI-compatible endpoint on 127.0.0.1:41891 and forwards chat requests to api.cline.bot. The ClinePass API key is passed through in memory only and is never written to disk by this plugin. Responses are read in memory to extract the gateway's routing metadata (finalProvider / pinnedProvider / fallbacksAvailable); the last result per model is stored in the plugin data directory. Nothing leaves the machine except requests to api.cline.bot."
    },
    "zh-CN": {
      "name": "Cline 上游",
      "description": "把 ClinePass 的真实上游摊开看：每个请求落在哪个上游、还有多少备选、缓存命中与成本。可勾选目标上游探测路由字段，实测网关会忽略。",
      "safetyNotes": "在本机 127.0.0.1:41891 跑一个 OpenAI 兼容端点，把对话请求转发到 api.cline.bot。你为该服务商填的 ClinePass API Key 只在内存中透传，插件不落盘。响应在内存中读取网关自己的路由元数据（finalProvider / pinnedProvider / fallbacksAvailable），只把每个模型的最近一次结果存到插件数据目录。除 api.cline.bot 与本地面板外不向任何地方发送数据。"
    }
  },
  "ui": {
    "panel": "renderer/index.html",
    "title": {
      "en": "Cline Upstream",
      "zh-CN": "Cline 上游"
    },
    "width": 1040,
    "height": 760
  },
  "activationEvents": [
    "onStartup"
  ],
  "contributes": {
    "commands": [
      {
        "id": "cline-upstream.open",
        "title": "Cline Upstream: 打开面板",
        "category": "Productivity",
        "keywords": [
          "cline",
          "upstream",
          "上游",
          "路由"
        ]
      },
      {
        "id": "cline-upstream.clear",
        "title": "Cline Upstream: 清空检测记录",
        "category": "Productivity",
        "keywords": [
          "cline",
          "clear",
          "清空"
        ]
      }
    ],
    "settings": [
      {
        "key": "enabled",
        "type": "boolean",
        "title": "启用 Cline Upstream",
        "default": true,
        "scope": "plugin"
      },
      {
        "key": "apiKey",
        "type": "string",
        "title": "ClinePass API Key（插件自己持有，仅用于转发）",
        "default": "",
        "scope": "plugin"
      },
      {
        "key": "enabledModels",
        "type": "string",
        "title": "启用哪些模型（逗号或空格分隔；留空 = 全部）",
        "default": "",
        "scope": "plugin"
      },
      {
        "key": "preferredUpstream",
        "type": "select",
        "title": "锚定到哪个上游",
        "default": "",
        "scope": "plugin",
        "enum": [
          {
            "label": "不指定（只观察）",
            "value": ""
          },
          {
            "label": "deepseek",
            "value": "deepseek"
          },
          {
            "label": "fireworks",
            "value": "fireworks"
          },
          {
            "label": "baseten",
            "value": "baseten"
          },
          {
            "label": "digitalocean",
            "value": "digitalocean"
          },
          {
            "label": "pareto",
            "value": "pareto"
          },
          {
            "label": "wafer",
            "value": "wafer"
          },
          {
            "label": "runware",
            "value": "runware"
          },
          {
            "label": "alibaba",
            "value": "alibaba"
          },
          {
            "label": "vertex",
            "value": "vertex"
          },
          {
            "label": "particle",
            "value": "particle"
          },
          {
            "label": "novita",
            "value": "novita"
          },
          {
            "label": "togetherai",
            "value": "togetherai"
          },
          {
            "label": "deepinfra",
            "value": "deepinfra"
          },
          {
            "label": "parasail",
            "value": "parasail"
          },
          {
            "label": "gmicloud",
            "value": "gmicloud"
          },
          {
            "label": "modal",
            "value": "modal"
          },
          {
            "label": "morph",
            "value": "morph"
          },
          {
            "label": "runinfra",
            "value": "runinfra"
          },
          {
            "label": "tencent",
            "value": "tencent"
          },
          {
            "label": "boundless",
            "value": "boundless"
          },
          {
            "label": "inference-net",
            "value": "inference-net"
          },
          {
            "label": "relace",
            "value": "relace"
          },
          {
            "label": "token-pass",
            "value": "token-pass"
          }
        ]
      },
      {
        "key": "injectRouting",
        "type": "boolean",
        "title": "尝试写入路由字段（provider.only）",
        "default": false,
        "scope": "plugin"
      },
      {
        "key": "hardPin",
        "type": "boolean",
        "title": "强制不降级（allow_fallbacks: false）",
        "default": false,
        "scope": "plugin"
      },
      {
        "key": "toastOnMismatch",
        "type": "boolean",
        "title": "实际落点与目标不符时提示",
        "default": true,
        "scope": "plugin"
      },
      {
        "key": "routingSnapshot",
        "type": "string",
        "title": "最近一次路由快照（插件自动写入，请勿修改）",
        "default": "",
        "scope": "plugin"
      }
    ],
    "services": [
      {
        "id": "provider-host",
        "label": "Cline Upstream provider host"
      }
    ],
    "providers": [
      {
        "id": "cline-upstream",
        "name": "Cline Upstream",
        "baseUrl": "http://127.0.0.1:41891/v1",
        "apiStyle": "chat_completions",
        "authKind": "none",
        "models": [
